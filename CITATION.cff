title: "Agent Manifest CLI"
message: "This repository is a validator for the Agent Manifest specification. If you are citing the specification itself, cite the preferred-citation below rather than this software."
type: software
version: "0.1.1"
url: "https://github.com/agent-manifest/agent-manifest-cli"
